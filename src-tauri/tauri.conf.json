{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Desk Calendar",
  "version": "0.1.0",
  "identifier": "com.rkdworn.deskcalendar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Desk Calendar",
        "width": 1100,
        "height": 800,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://www.googleapis.com",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "rkdworn",
    "shortDescription": "바탕화면 캘린더",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
